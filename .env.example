# Optional PostgreSQL/Neon connection string. Leave empty for local synthetic mode.
DATABASE_URL=

# Google OAuth web client. Add the Flask callback URL to the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/callback
GOOGLE_ROLE_MAP={}
SESSION_SECRET=
AUTH_REQUIRED=false
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# Optional Gemini API key; without it, the research assistant uses a constrained local parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional model providers. Keys are read only by Flask, never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# SAP BTP destination service. Configure the OData path as a read-only resource.
SAP_BTP_TOKEN_URL=
SAP_BTP_CLIENT_ID=
SAP_BTP_CLIENT_SECRET=
SAP_BTP_DESTINATION_SERVICE_URL=
SAP_BTP_DESTINATION_NAME=
SAP_ODATA_READ_PATH=

# Optional Flask port (default: 5000).
PORT=5000
